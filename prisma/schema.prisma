// One entry's role inside a captured EvidenceThread. Kept distinct rather
// than collapsed into one value - the classifier's decision-point logic and
// any future risk scoring both need to tell a human argument (message,
// comment) apart from a machine-recorded fact (status_change) and from the
// approval action itself.
enum EvidenceEntryKind {
  MESSAGE
  COMMENT
  REVIEW
  STATUS_CHANGE
  APPROVAL
  ATTACHMENT
  TRANSCRIPT_SEGMENT
}

enum EvidenceProviderConnectionStatus {
  CONNECTED
  SYNCING
  DEGRADED
  ERROR
  REAUTH_REQUIRED
  DISCONNECTED
}

