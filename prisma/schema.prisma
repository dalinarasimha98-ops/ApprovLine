model Organization {
  id                       String                         @id @default(cuid())
  clerkOrgId               String?                        @unique
  name                     String
  slug                     String                         @unique
  companyDomain            String?
  // --- Organization Settings: Branding ---------------------------------
  /// Validated 6-digit hex (e.g. "#7C3AED"). Rejected server-side if it
  /// would fail WCAG AA contrast against the app's surface tokens.
  brandColor               String?
  /// Vercel Blob URL for the uploaded org logo. Never a client-supplied
  /// arbitrary URL - only ever set by the logo upload route after content
  /// validation.
  logoUrl                  String?
  logoUpdatedAt            DateTime?
  // --- Organization Settings: Custom domain (real state machine, no fake
  // --- DNS verification - customDomainStatus only moves to VERIFIED after
  // --- a genuine DNS TXT lookup finds the expected token) ----------------
  customDomain             String?
  customDomainStatus       CustomDomainStatus             @default(NOT_CONFIGURED)
  customDomainVerifyToken  String?
  customDomainVerifiedAt   DateTime?
  // --- Organization Settings: Default preferences ------------------------
  /// IANA timezone. Falls back to for org-scoped date/time display when a
  /// user has no personal User.timezone set (see services/userSettings.ts).
  defaultTimeZone          String?
  /// One of DATE_FORMAT_OPTIONS in lib/dateFormat.ts.
  defaultDateFormat        String?
  /// One of WORKSPACE_VIEW_OPTIONS in lib/workspaceViews.ts - consumed by
  /// app/get-started/page.tsx's post-sign-in redirect.
  defaultWorkspaceView     String?
  /// One of the real classifier RiskLevel values ('low'|'medium'|'high'|
  /// 'critical') - used as the fallback shown when no other default exists.
  defaultRiskLevel         String?
  // --- Organization Settings: Approval policy -----------------------------
  /// When false, newly persisted ApprovalRecords have category nulled out
  /// regardless of what the classifier returned (services/classifier/
  /// persistence.ts). Never affects existing records or skips capture.
  autoCategorizationEnabled Boolean                       @default(true)
  /// When false, newly persisted ApprovalRecords have riskLevel nulled out.
  riskDetectionEnabled     Boolean                        @default(true)
  /// Applied as ApprovalRecord.dueDate when the classifier did not supply
  /// one. Null means no organization default is configured.
  defaultDueDateDays       Int?
  industry                 String?
  companySize              String?
  country                  String?
  primaryAdminName         String?
  primaryAdminEmail        String?
  departments              String[]
  approvalCategories       String[]
  onboardingStep           Int                            @default(1)
  onboardingStatus         Json?
  onboardingStartedAt      DateTime?
  onboardingLastSavedAt    DateTime?
  onboardingCompletedSteps String[]
  onboardingReadinessScore Int                            @default(0)
  invitedTeamMembers       Json?
  integrationSetup         Json?
  playbookSetup            Json?
  copilotSetup             Json?
  memoryGraphInitializedAt DateTime?
  onboardedAt              DateTime?
  createdAt                DateTime                       @default(now())
  updatedAt                DateTime                       @updatedAt
  users                    User[]
  teams                    Team[]
  integrations             Integration[]
  approvalRecords          ApprovalRecord[]
  auditLogs                AuditLog[]
  classifierResults        ClassifierResult[]
  subscriptions            Subscription[]
  events                   Event[]
  messageSources           MessageSource[]
  idempotencyRecords       IdempotencyRecord[]
  backgroundJobs           BackgroundJob[]
  deadLetterJobs           DeadLetterJob[]
  outboxEvents             OutboxEvent[]
  workerHeartbeats         WorkerHeartbeat[]
  playbookDocuments        PlaybookDocument[]
  playbookChunks           PlaybookChunk[]
  playbookRules            PlaybookRule[]
  playbookQueries          PlaybookQuery[]
  complianceEvaluations    ApprovalComplianceEvaluation[]
  investigations           InvestigationCase[]
  investigationNotes       InvestigationNote[]
  featureFlags             FeatureFlag[]
  pilotInvites             PilotInvite[]
  pilotFeedback            PilotFeedback[]
  pilotActivityLogs        PilotActivityLog[]
  customerAccount          CustomerAccount?
  customerWorkspace        CustomerWorkspace?
  founderManagedUsers      FounderManagedUser[]
  memoryEntities           MemoryEntity[]
  memoryRelationships      MemoryRelationship[]
  memoryGraphEvents        MemoryGraphEvent[]
  memoryTimelineEvents     MemoryTimelineEvent[]
  manualApprovalDetails    ManualApprovalDetail[]
  manualApprovalVersions   ManualApprovalVersion[]
  evidenceAssociations     ApprovalEvidenceAssociation[]
  approvalConfirmations    ApprovalConfirmationRequest[]
  evidenceConnections      EvidenceProviderConnection[]
  canonicalEvidenceEvents  CanonicalEvidenceEvent[]
  unifiedEvidenceRecords   UnifiedEvidenceRecord[]
  evidenceProviderHealth   EvidenceProviderHealth[]
  evidenceFailures         EvidenceProcessingFailure[]
  tenantProviderAccess     TenantProviderAccess[]
  integrationRequests      IntegrationRequest[]
  complianceFrameworks     ComplianceFramework[]
  complianceControls       ComplianceControl[]
  complianceIssues         ComplianceIssue[]
  complianceAttestations   ComplianceAttestation[]
  complianceDeadlines      ComplianceDeadline[]
  evidenceThreads          EvidenceThread[]
  evidenceEntries          EvidenceEntry[]

  @@index([onboardedAt])
  @@index([onboardingStep])
  @@index([industry])
}

model User {
  id                             String                        @id @default(cuid())
  organizationId                 String
  clerkUserId                    String                        @unique
  email                          String
  name                           String?
  role                           Role                          @default(MEMBER)
  // Self-reported personal/professional profile fields (User Settings ->
  // Profile). Deliberately separate from Clerk's own identity fields
  // (name/email/avatar, which stay Clerk-owned) - these have no equivalent
  // anywhere else in the app, so this is new data, not a duplicate store.
  jobTitle                       String?
  // Soft-constrained (not a DB enum/FK) to the owning Organization's own
  // `departments` string list - the same list Users & Teams and Reports
  // already treat as that org's authoritative department set - so the
  // Edit Profile dropdown never lets a user pick a department their
  // organization hasn't defined.
  department                     String?
  phone                          String?
  location                       String?
  // IANA timezone identifier (e.g. "America/New_York"), validated against
  // Intl.supportedValuesOf('timeZone') at write time - never a fabricated
  // fixed list.
  timezone                       String?
  // Personal appearance preference (User Settings -> Preferences -> Theme):
  // 'dark' | 'light' | 'system'. Null means "never explicitly chosen" and is
  // treated as 'dark' - ApprovLine was dark-only before this feature, so an
  // unset preference must keep every existing user's current look rather
  // than silently switching them to their OS preference. This is the
  // durable, cross-device source of truth; the fast SSR read that avoids a
  // flash of the wrong theme on page load uses a cookie mirror of this same
  // value (see app/layout.tsx and services/userSettings.ts).
  theme                          String?
  // An organizational fact, not self-reported: no admin UI sets this yet
  // (out of scope for this change), so it is always null today and User
  // Settings renders it as a plain, honest "Not set" - a real, correctly
  // modeled relationship rather than an invented manager.
  managerId                      String?
  manager                        User?                         @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports                  User[]                        @relation("UserManager")
  notificationPreference         UserNotificationPreference?
  createdAt                      DateTime                      @default(now())
  updatedAt                      DateTime                      @updatedAt
  organization                   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  teams                          TeamMember[]
  approvals                      ApprovalRecord[]              @relation("ApprovalApprover")
  auditLogs                      AuditLog[]
  investigationNotes             InvestigationNote[]
  assignedInvestigations         InvestigationCase[]           @relation("InvestigationAssignee")
  createdInvestigations          InvestigationCase[]           @relation("InvestigationCreator")
  pilotInvites                   PilotInvite[]                 @relation("PilotInviteInviter")
  pilotFeedback                  PilotFeedback[]
  pilotActivityLogs              PilotActivityLog[]
  featureFlagsUpdated            FeatureFlag[]                 @relation("FeatureFlagUpdater")
  recordedManualApprovals        ManualApprovalDetail[]        @relation("ManualApprovalRecorder")
  verifiedManualApprovals        ManualApprovalDetail[]        @relation("ManualApprovalSecondVerifier")
  manualApprovalVersions         ManualApprovalVersion[]       @relation("ManualApprovalVersionActor")
  verifiedEvidenceAssociations   ApprovalEvidenceAssociation[] @relation("EvidenceAssociationVerifier")
  rejectedEvidenceAssociations   ApprovalEvidenceAssociation[] @relation("EvidenceAssociationRejecter")
  requestedApprovalConfirmations ApprovalConfirmationRequest[] @relation("ApprovalConfirmationRequester")
  authoredEvidenceEntries        EvidenceEntry[]

  @@index([organizationId, role])
  @@index([email])
  @@index([managerId])
}

/**
 * Personal, per-user notification preferences (User Settings -> Notifications).
 * Deliberately its own tiny table rather than columns on User, matching this
 * schema's existing pattern of one small dedicated model per concern
 * (e.g. EvidenceProviderHealth next to EvidenceProviderConnection) - and
 * because "no row yet" cleanly means "defaults" without a migration-time
 * backfill.
 *
 * emailEnabled controls ONLY the optional, non-critical email nudge sent
 * when this user (by email) is asked to confirm a manual approval recorded
 * on their behalf (see app/api/approvals/[id]/confirmations/route.ts).
 * Disabling it never removes the underlying ApprovalConfirmationRequest,
 * its audit trail, or the requirement to act on it - those are the actual
 * compliance mechanism and are never gated by this preference. Only the
 * convenience email is optional.
 */
model UserNotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emailEnabled Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Team {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  department     String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMember[]

  @@unique([organizationId, name])
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  userId    String
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model Integration {
  id              String              @id @default(cuid())
  organizationId  String
  provider        IntegrationProvider
  status          IntegrationStatus   @default(CONNECTED)
  externalAccount String?
  scopes          String[]
  encryptedTokens Json?
  metadata        Json?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageSources  MessageSource[]
  events          Event[]

  @@unique([organizationId, provider, externalAccount])
  @@index([organizationId, provider])
}

model MessageSource {
  id                   String                        @id @default(cuid())
  organizationId       String
  integrationId        String?
  provider             IntegrationProvider
  externalId           String?
  threadId             String?
  eventId              String?
  channel              String?
  sender               String?
  senderEmail          String?
  contentHash          String?
  correlationId        String?
  idempotencyKey       String?
  rawPayload           Json?
  receivedAt           DateTime                      @default(now())
  organization         Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  integration          Integration?                  @relation(fields: [integrationId], references: [id], onDelete: SetNull)
  approvalRecords      ApprovalRecord[]
  classifierResults    ClassifierResult[]
  evidenceAssociations ApprovalEvidenceAssociation[]

  @@unique([organizationId, provider, externalId])
  @@index([organizationId, provider, receivedAt])
  @@index([externalId])
  @@index([organizationId, provider, threadId])
  @@index([organizationId, provider, eventId])
  @@index([organizationId, contentHash])
  @@index([organizationId, idempotencyKey])
}

model ApprovalRecord {
  id                      String                         @id @default(cuid())
  organizationId          String
  messageSourceId         String?
  approverUserId          String?
  approverName            String?
  approverEmail           String?
  subject                 String
  department              String?
  category                String?
  approvalType            ApprovalType
  status                  ApprovalStatus
  confidence              Int
  riskLevel               String?
  businessImpact          String?
  reasoning               String
  conditions              String?
  sourcePlatform          String?
  sourceLink              String?
  evidenceSnippet         String?
  duplicateDisposition    String?
  duplicateReason         String?
  sourceSystem            String?
  sourceRecordId          String?
  contentHash             String?
  correlationId           String?
  idempotencyKey          String?
  approvalTimestamp       DateTime?
  /// Set from Organization.defaultDueDateDays at creation time
  /// (services/classifier/persistence.ts) when the org has configured a
  /// default. Null when no organization default exists - the classifier
  /// itself never produces a due date.
  dueDate                 DateTime?
  occurredAt              DateTime                       @default(now())
  createdAt               DateTime                       @default(now())
  updatedAt               DateTime                       @updatedAt
  organization            Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  messageSource           MessageSource?                 @relation(fields: [messageSourceId], references: [id], onDelete: SetNull)
  approverUser            User?                          @relation("ApprovalApprover", fields: [approverUserId], references: [id], onDelete: SetNull)
  classifierResults       ClassifierResult[]
  auditLogs               AuditLog[]
  investigations          InvestigationApproval[]
  complianceEvaluations   ApprovalComplianceEvaluation[]
  manualDetail            ManualApprovalDetail?
  manualVersions          ManualApprovalVersion[]
  evidenceAssociations    ApprovalEvidenceAssociation[]
  confirmationRequests    ApprovalConfirmationRequest[]
  canonicalEvidenceEvents CanonicalEvidenceEvent[]
  unifiedEvidenceRecords  UnifiedEvidenceRecord[]        @relation("UnifiedEvidencePrimaryApproval")

  @@index([organizationId, occurredAt])
  @@index([organizationId, department])
  @@index([organizationId, approverName])
  @@index([organizationId, approverEmail])
  @@index([organizationId, category])
  @@index([organizationId, riskLevel])
  @@index([organizationId, sourcePlatform])
  @@index([organizationId, approvalType])
  @@index([organizationId, idempotencyKey])
  @@index([organizationId, correlationId])
  @@index([organizationId, sourceSystem, sourceRecordId])
  @@index([organizationId, contentHash])
  @@index([organizationId, status, occurredAt])
  @@index([organizationId, createdAt])
}

// --- Thread-level evidence capture --------------------------------------
// EvidenceThread/EvidenceEntry is the real capture layer going forward,
// replacing what MessageSource has always tried (and, by design, failed)
// to be: MessageSource holds exactly one event, so the objection that was
// raised and answered, the condition attached to an approval, the review
// that blocked a merge - all of it lived in the same conversation as the
// one message MessageSource kept, and none of the rest was ever captured.
//
// Deliberately NOT linked to ApprovalRecord. MessageSource/ApprovalRecord
// keep running exactly as they are, untouched - this is an additive capture
// layer beside the old path, not a cutover. A captured thread instead feeds
// the already-live canonical pipeline (CanonicalEvidenceEvent ->
// UnifiedEvidenceRecord via services/evidence/pipeline.ts's
// scoreEvidenceCandidate()/correlateEvent()) exactly the way single events
// do today; CanonicalEvidenceEvent already carries its own threadId string
// for that purpose. How a thread's entries map into CanonicalEvidenceEvent
// rows is capture-logic (connector work), not schema, and is intentionally
// left to a later stage rather than decided here.
//
// Re-capture is never an edit: a re-fetched thread (e.g. new replies a week
// after the decision was hashed) writes a brand-new row with `version`
// incremented, matching the immutable-version-per-change convention
// ManualApprovalVersion already establishes elsewhere in this schema. A
// prior version's rows are never mutated once written.
model EvidenceThread {
  id               String    @id @default(cuid())
  organizationId   String
  // Free-form (not the IntegrationProvider enum) to match
  // CanonicalEvidenceEvent.providerKey/the Evidence Provider SDK's catalog -
  // the system this table feeds - rather than the older OAuth-connector
  // enum MessageSource uses, so a future provider never needs a schema
  // migration just to be nameable here.
  provider         String
  externalThreadId String
  externalUrl      String?
  title            String?
  entryCount       Int       @default(0)
  participantCount Int       @default(0)
  firstEntryAt     DateTime?
  lastEntryAt      DateTime?
  // Computed over the full ordered thread (sequence, timestamp, author,
  // kind, body, canonicalised providerMeta - never rendered HTML, never
  // ApprovLine's own annotations), not the excerpt anyone is shown.
  contentHash      String?
  hashAlgorithm    String?
  hashedAt         DateTime?
  // False until every paginated cursor has run to the end and been
  // written; a thread must never look complete at 40 of 60 entries with
  // nothing downstream able to tell.
  complete         Boolean   @default(false)
  capturedAt       DateTime  @default(now())
  version          Int       @default(1)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  organization     Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entries          EvidenceEntry[]

  // Makes re-capture idempotent: writing the same external thread again at
  // the same version is a no-op collision, and a genuine re-capture always
  // supplies the next version rather than colliding.
  @@unique([organizationId, provider, externalThreadId, version])
  @@index([organizationId, capturedAt])
  // Finds threads a resumed/retried capture still needs to finish.
  @@index([organizationId, complete])
}

model EvidenceEntry {
  id             String            @id @default(cuid())
  organizationId String
  threadId       String
  // 0-based (or 1-based, capture-logic's choice) position in the thread's
  // true chronological order - interleaved across every paginated source
  // the connector reads (e.g. GitHub's four endpoints, ServiceNow's
  // approver/journal tables), not per-source order.
  sequence       Int
  authorHandle   String?
  // Resolved by email, then provider handle, then display name - and
  // nothing fuzzier than that (capture-logic concern; schema just holds
  // the nullable result of that match).
  authorUserId   String?
  at             DateTime
  kind           EvidenceEntryKind
  body           String?
  bodyRaw        String?
  // Per-provider shape, validated in code (services/evidence/*), not typed
  // columns - see docs/universal-evidence-platform.md's provider table for
  // what each provider's keys are. A new connector is a code change here,
  // never a migration.
  providerMeta   Json?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread         EvidenceThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  authorUser     User?             @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  // Also serves as the ordered-read index for a full thread (threadId,
  // sequence) - a unique B-tree index satisfies both idempotent per-page
  // upsert-by-sequence writes and the "read a full record in order" query.
  @@unique([threadId, sequence])
  @@index([organizationId, at])
  @@index([organizationId, authorUserId])
}

model EvidenceProviderConnection {
  id                   String                           @id @default(cuid())
  organizationId       String
  providerKey          String
  displayName          String
  category             String
  status               EvidenceProviderConnectionStatus @default(DISCONNECTED)
  authenticationType   String?
  scopes               String[]
  encryptedCredentials Json?
  configuration        Json?
  connectedAt          DateTime?
  disconnectedAt       DateTime?
  lastSyncAt           DateTime?
  createdAt            DateTime                         @default(now())
  updatedAt            DateTime                         @updatedAt
  organization         Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  canonicalEvents      CanonicalEvidenceEvent[]
  health               EvidenceProviderHealth?

  @@unique([organizationId, providerKey])
  @@index([organizationId, status])
  @@index([providerKey, status])
}

model CanonicalEvidenceEvent {
  id                  String                      @id @default(cuid())
  organizationId      String
  connectionId        String?
  approvalRecordId    String?
  unifiedRecordId     String?
  providerKey         String
  providerEventType   String
  occurredAt          DateTime
  receivedAt          DateTime                    @default(now())
  actorId             String?
  actorName           String?
  actorEmail          String?
  tenantExternalId    String?
  objectType          String
  objectId            String?
  threadId            String?
  parentId            String?
  relatedIds          String[]
  participants        Json?
  attachments         Json?
  links               Json?
  content             String?
  metadata            Json?
  encryptedRawPayload String?
  evidenceHash        String
  correlationId       String
  correlationKeys     String[]
  confidence          Int                         @default(100)
  status              EvidenceEventStatus         @default(RECEIVED)
  processingAttempts  Int                         @default(0)
  lastError           String?
  lastProcessedAt     DateTime?
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  organization        Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection          EvidenceProviderConnection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  approvalRecord      ApprovalRecord?             @relation(fields: [approvalRecordId], references: [id], onDelete: SetNull)
  unifiedRecord       UnifiedEvidenceRecord?      @relation(fields: [unifiedRecordId], references: [id], onDelete: SetNull)
  memberships         UnifiedEvidenceMember[]
  failures            EvidenceProcessingFailure[]

  @@unique([organizationId, providerKey, evidenceHash])
  @@index([organizationId, occurredAt])
  @@index([organizationId, providerKey, occurredAt])
  @@index([organizationId, objectType, objectId])
  @@index([organizationId, threadId])
  @@index([organizationId, correlationId])
  @@index([organizationId, status, receivedAt])
  @@index([unifiedRecordId, occurredAt])
}

model UnifiedEvidenceRecord {
  id                 String                   @id @default(cuid())
  organizationId     String
  primaryApprovalId  String?
  subject            String
  decision           String?
  outcome            String?
