model CustomerPlan {
  id               String           @id @default(cuid())
  planTier         CustomerPlanTier @unique
  name             String
  description      String?
  seatLimitDefault Int              @default(5)
  priceLabel       String?
  features         String[]
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
}

model CustomerSeatAllocation {
  id                String          @id @default(cuid())
  customerAccountId String          @unique
  purchasedSeats    Int             @default(5)
  allocatedSeats    Int             @default(5)
  usedSeats         Int             @default(0)
  updatedAt         DateTime        @updatedAt
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
}

model CustomerFeatureFlag {
  id                String          @id @default(cuid())
  customerAccountId String
  key               String
  enabled           Boolean         @default(false)
  category          String?
  updatedBy         String?
  updatedAt         DateTime        @updatedAt
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, key])
  @@index([key, enabled])
}

model CustomerIntegrationStatus {
  id                String                             @id @default(cuid())
  customerAccountId String
  provider          String
  accessEnabled     Boolean                            @default(false)
  connectionState   CustomerIntegrationConnectionState @default(NOT_ENABLED)
  lastSyncAt        DateTime?
  errorCount        Int                                @default(0)
  eventsProcessed   Int                                @default(0)
  metadata          Json?
  updatedAt         DateTime                           @updatedAt
  customerAccount   CustomerAccount                    @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, provider])
  @@index([provider, connectionState])
}

model FounderAuditLog {
  id                String           @id @default(cuid())
  customerAccountId String?
  actorUserId       String?
  actorEmail        String?
  actorRole         String?
  action            String
  targetType        String
  targetId          String?
  metadata          Json?
  createdAt         DateTime         @default(now())
  customerAccount   CustomerAccount? @relation(fields: [customerAccountId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorEmail])
  @@index([customerAccountId, createdAt])
  @@index([action])
}

model CustomerNote {
  id                String          @id @default(cuid())
  customerAccountId String
  authorEmail       String?
  body              String
  pinned            Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  customerAccount   CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([customerAccountId, pinned, createdAt])
  @@index([customerAccountId, createdAt])
}

model CustomerHealth {
  id                    String               @id @default(cuid())
  customerAccountId     String               @unique
  status                CustomerHealthStatus @default(NEEDS_ATTENTION)
  score                 Int                  @default(50)
  lastLoginAt           DateTime?
  activeUsers           Int                  @default(0)
  approvalsProcessed    Int                  @default(0)
  integrationsConnected Int                  @default(0)
  playbookUsage         Int                  @default(0)
  copilotUsage          Int                  @default(0)
  updatedAt             DateTime             @updatedAt
  customerAccount       CustomerAccount      @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)

  @@index([status, score])
}

model FounderManagedUser {
  id                String                   @id @default(cuid())
  customerAccountId String
  organizationId    String
  firstName         String
  lastName          String
  email             String
  role              FounderManagedUserRole   @default(VIEWER)
  status            FounderManagedUserStatus @default(INVITED)
  inviteToken       String?                  @unique
  invitedAt         DateTime                 @default(now())
  acceptedAt        DateTime?
  expiresAt         DateTime?
  revokedAt         DateTime?
  suspendedAt       DateTime?
  removedAt         DateTime?
  createdAt         DateTime                 @default(now())
  updatedAt         DateTime                 @updatedAt
  customerAccount   CustomerAccount          @relation(fields: [customerAccountId], references: [id], onDelete: Cascade)
  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([customerAccountId, email])
  @@index([organizationId, status])
  @@index([customerAccountId, status])
  @@index([customerAccountId, role])
  @@index([email])
}

model MemoryEntity {
  id                    String                @id @default(cuid())
  organizationId        String
  type                  MemoryEntityType
  title                 String
  subtitle              String?
  summary               String?
  externalType          String?
  externalId            String?
  sourceSystem          String?
  riskScore             Int                   @default(0)
  metadata              Json?
  firstSeenAt           DateTime              @default(now())
  lastSeenAt            DateTime              @default(now())
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  organization          Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outgoingRelationships MemoryRelationship[]  @relation("MemoryRelationshipFrom")
  incomingRelationships MemoryRelationship[]  @relation("MemoryRelationshipTo")
  graphEvents           MemoryGraphEvent[]
  timelineEvents        MemoryTimelineEvent[]

  @@unique([organizationId, type, externalId])
  @@index([organizationId, type, updatedAt])
  @@index([organizationId, title])
  @@index([organizationId, riskScore])
}

model MemoryRelationship {
  id               String       @id @default(cuid())
  organizationId   String
  fromEntityId     String
  toEntityId       String
  relationshipType String
  confidence       Int          @default(100)
  evidenceSnippet  String?
  sourceSystem     String?
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromEntity       MemoryEntity @relation("MemoryRelationshipFrom", fields: [fromEntityId], references: [id], onDelete: Cascade)
  toEntity         MemoryEntity @relation("MemoryRelationshipTo", fields: [toEntityId], references: [id], onDelete: Cascade)

  @@unique([organizationId, fromEntityId, toEntityId, relationshipType])
  @@index([organizationId, relationshipType])
  @@index([organizationId, fromEntityId])
  @@index([organizationId, toEntityId])
}

model MemoryGraphEvent {
  id             String        @id @default(cuid())
  organizationId String
  entityId       String?
  action         String
  sourceSystem   String?
  payload        Json?
  createdAt      DateTime      @default(now())
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         MemoryEntity? @relation(fields: [entityId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([organizationId, action])
  @@index([entityId])
}

model MemoryTimelineEvent {
  id             String       @id @default(cuid())
  organizationId String
  entityId       String
  title          String
  description    String?
  eventType      String
  sourceSystem   String?
  occurredAt     DateTime
  sourceLink     String?
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entity         MemoryEntity @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt])
  @@index([organizationId, eventType])
  @@index([entityId, occurredAt])
}

// Integration Marketplace models

model MarketplaceProvider {
  id           String                    @id @default(cuid())
  slug         String                    @unique
  displayName  String
  category     String
  description  String
  logoUrl      String?
  websiteUrl   String?
  status       MarketplaceProviderStatus @default(AVAILABLE)
  isNative     Boolean                   @default(false)
  capabilities Json?
  requestCount Int                       @default(0)
  sortOrder    Int                       @default(0)
  createdAt    DateTime                  @default(now())
  updatedAt    DateTime                  @updatedAt
  tenantAccess TenantProviderAccess[]
  requests     IntegrationRequest[]

  @@index([status])
  @@index([category])
  @@index([sortOrder])
}

model TenantProviderAccess {
  id             String              @id @default(cuid())
  organizationId String
  providerSlug   String
  enabledAt      DateTime            @default(now())
  enabledBy      String?
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       MarketplaceProvider @relation(fields: [providerSlug], references: [slug], onDelete: Cascade)

  @@unique([organizationId, providerSlug])
  @@index([organizationId])
  @@index([providerSlug])
}

model IntegrationRequest {
  id                String                     @id @default(cuid())
  organizationId    String
  requestedByUserId String?
  providerSlug      String?
  providerName      String
  providerWebsite   String?
  category          String?
  reason            String
  evidenceType      String?
  userCount         Int?
  priority          IntegrationRequestPriority @default(MEDIUM)
  status            IntegrationRequestStatus   @default(PENDING)
  founderNotes      String?
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider          MarketplaceProvider?       @relation(fields: [providerSlug], references: [slug], onDelete: SetNull)

  @@index([organizationId, status, createdAt])
  @@index([providerSlug, status])
  @@index([status, priority, createdAt])
}

// ── Compliance Hub models ──────────────────────────────────────────────────

model ComplianceFramework {
  id               String    @id @default(cuid())
  organizationId   String
  slug             String    // iso27001 | soc2 | gdpr | hipaa | pcidss | nist_csf | custom
  name             String
  description      String?
  isEnabled        Boolean   @default(true)
  lastAssessmentAt DateTime?
  metadata         Json?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  controls     ComplianceControl[]
  issues       ComplianceIssue[]
  deadlines    ComplianceDeadline[]

  @@unique([organizationId, slug])
  @@index([organizationId])
}

model ComplianceControl {
  id             String    @id @default(cuid())
  organizationId String
  frameworkId    String
  controlRef     String    // e.g. "CC6.1", "A.8.1"
  name           String
  description    String?
  category       String?
  owner          String?
  // EFFECTIVE | PARTIALLY_EFFECTIVE | INEFFECTIVE | NOT_ASSESSED
  status         String    @default("NOT_ASSESSED")
  effectiveness  Int?      // 0-100
  playbookRuleId String?
  lastTestedAt   DateTime?
  nextReviewAt   DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework    ComplianceFramework   @relation(fields: [frameworkId], references: [id], onDelete: Cascade)
  issues       ComplianceIssue[]
  attestations ComplianceAttestation[]

  @@index([organizationId])
  @@index([frameworkId])
  @@index([organizationId, status])
}

model ComplianceIssue {
  id                  String    @id @default(cuid())
  organizationId      String
  frameworkId         String?
  controlId           String?
  title               String
  description         String?
  // CRITICAL | HIGH | MEDIUM | LOW
  severity            String    @default("MEDIUM")
  // OPEN | IN_PROGRESS | RESOLVED | ACCEPTED | DEFERRED
  status              String    @default("OPEN")
  owner               String?
  dueDate             DateTime?
  resolvedAt          DateTime?
  investigationCaseId String?
  approvalRecordId    String?
  metadata            Json?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework    ComplianceFramework? @relation(fields: [frameworkId], references: [id])
  control      ComplianceControl?   @relation(fields: [controlId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, severity])
  @@index([organizationId, status, severity])
}

model ComplianceAttestation {
  id                String    @id @default(cuid())
  organizationId    String
  controlId         String?
  title             String
  policy            String?
  owner             String?
  // PENDING | COMPLETED | OVERDUE | REJECTED
  status            String    @default("PENDING")
  dueDate           DateTime?
  completedAt       DateTime?
  completedByUserId String?
  notes             String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  control      ComplianceControl? @relation(fields: [controlId], references: [id])

  @@index([organizationId])
  @@index([organizationId, status])
}

model ComplianceDeadline {
  id             String    @id @default(cuid())
  organizationId String
  frameworkId    String?
  title          String
  // AUDIT | ASSESSMENT | REVIEW | TRAINING | CERTIFICATION
  type           String
  owner          String?
  dueDate        DateTime
  // UPCOMING | IN_PROGRESS | COMPLETED | OVERDUE
  status         String    @default("UPCOMING")
  description    String?
  metadata       Json?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  framework    ComplianceFramework? @relation(fields: [frameworkId], references: [id])

  @@index([organizationId])
  @@index([organizationId, dueDate])
}
